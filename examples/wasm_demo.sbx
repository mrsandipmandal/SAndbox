// wasm_demo.sbx — WebAssembly target demo
// Build: sandbox build wasm_demo.sbx --target wasm

fn add(a: i64, b: i64) -> i64 {
    return a + b
}

fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn main() {
    let x = add(3, 4)
    print(x)

    let f = factorial(5)
    print(f)

    let f10 = factorial(10)
    print(f10)
}
