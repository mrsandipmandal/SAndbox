fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1
    }
    let mut result: i64 = 1
    let mut i: i64 = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

fn fibonacci(n: i64) -> i64 {
    if n <= 0 {
        return 0
    }
    if n == 1 {
        return 1
    }
    let mut a: i64 = 0
    let mut b: i64 = 1
    let mut i: i64 = 2
    while i <= n {
        let temp = a + b
        a = b
        b = temp
        i = i + 1
    }
    return b
}

fn gcd(a: i64, b: i64) -> i64 {
    let mut x = a
    let mut y = b
    while y != 0 {
        let temp = y
        y = x % y
        x = temp
    }
    return x
}

fn lcm(a: i64, b: i64) -> i64 {
    return (a * b) / gcd(a, b)
}

fn is_prime(n: i64) -> bool {
    if n <= 1 {
        return false
    }
    if n <= 3 {
        return true
    }
    if (n % 2) == 0 {
        return false
    }
    if (n % 3) == 0 {
        return false
    }
    let mut i: i64 = 5
    while (i * i) <= n {
        if (n % i) == 0 {
            return false
        }
        if (n % (i + 2)) == 0 {
            return false
        }
        i = i + 6
    }
    return true
}

fn nth_prime(n: i64) -> i64 {
    let mut count: i64 = 0
    let mut candidate: i64 = 1
    while count < n {
        candidate = candidate + 1
        if is_prime(candidate) {
            count = count + 1
        }
    }
    return candidate
}

fn sum_of_digits(n: i64) -> i64 {
    let mut num = n
    let mut sum: i64 = 0
    while num > 0 {
        sum = sum + num % 10
        num = num / 10
    }
    return sum
}

fn reverse_number(n: i64) -> i64 {
    let mut num = n
    let mut reversed: i64 = 0
    while num > 0 {
        reversed = reversed * 10 + num % 10
        num = num / 10
    }
    return reversed
}

fn power_mod(base: i64, exp: i64, modulus: i64) -> i64 {
    let mut result: i64 = 1
    let b = base % modulus
    let e = exp
    let m = modulus
    let mut i: i64 = 0
    while i < e {
        result = (result * b) % m
        i = i + 1
    }
    return result
}

fn clamp(value: i64, lo: i64, hi: i64) -> i64 {
    if value < lo {
        return lo
    }
    if value > hi {
        return hi
    }
    return value
}

fn lerp(a: i64, b: i64, t: i64) -> i64 {
    return a + (b - a) * t / 100
}

fn collatz_steps(n: i64) -> i64 {
    let mut num = n
    let mut steps: i64 = 0
    while num != 1 {
        if (num % 2) == 0 {
            num = num / 2
        } else {
            num = 3 * num + 1
        }
        steps = steps + 1
    }
    return steps
}
